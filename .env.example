# =====================================================================
# Настройки агента. Скопируйте в .env и правьте под себя.
# Значение из окружения важнее строки в этом файле.
# =====================================================================

# ---------- Сайт ----------
# Слушаем 0.0.0.0 — только так работает проброс порта снаружи.
SITE_HOST=0.0.0.0
SITE_PORT=8000
# HTTPS с самоподписанным сертификатом (браузер один раз предупредит).
SITE_TLS=1
# Имена/IP, которые попадут в сертификат (через запятую).
# Впишите IP своего мака в домашней сети — иначе сертификат подойдёт только для петли.
SITE_TLS_NAMES=127.0.0.1,localhost,192.168.1.10
PUBLIC_URL=https://192.168.1.10:8000
# Пароль на вход в интерфейс. Пусто — вход без пароля.
SITE_PASSWORD=

# ---------- LLM (DeepSeek) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# «deepseek 4 flash» = deepseek-flash (DeepSeek-V4.1-Flash).
DEEPSEEK_MODEL=deepseek-flash
# Размышления (thinking/reasoning) выключены — см. core/llm.py.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2400
LLM_TIMEOUT=120

# ---------- Kinozal ----------
KINOZAL_BASE_URL=https://kinozal.me
KINOZAL_USERNAME=
KINOZAL_PASSWORD=

# ---------- Transmission (RPC) ----------
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_USERNAME=
# Куда Transmission складывает загрузки. Всегда ВНЕШНИЙ диск: если он не
# смонтирован, агент откажется ставить раздачу, а не зальёт её на системный.
# Подставьте путь своего тома: /Volumes/ИМЯ_ДИСКА/torrents
TRANSMISSION_DOWNLOAD_DIR=/Volumes/ВНЕШНИЙ_ДИСК/torrents
# Сколько места обязано остаться на диске после скачивания (ГБ).
TRANSMISSION_MIN_FREE_GB=5
TRANSMISSION_PASSWORD=

# ---------- Обход Cloudflare на kinozal.me ----------
# Локальный сервис, который добывает cookie cf_clearance настоящим Chrome.
GATE_HOST=127.0.0.1
GATE_PORT=8123
GATE_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Chrome в headless Cloudflare не пускает — нужен обычный, но сдвинутый за экран.
GATE_HEADLESS=0
GATE_PROFILE_DIR=data/chrome-profile

# ---------- Хранение ----------
DATA_DIR=data
DB_PATH=data/agent.sqlite3
TORRENTS_DIR=/Volumes/ВНЕШНИЙ_ДИСК/torrent-files

# ---------- Периодические задачи ----------
DEFAULT_INTERVAL_MINUTES=30
MIN_INTERVAL_MINUTES=5
